
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Helpdesk & Circular Portal</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fb;
            color: #333;
            line-height: 1.6;
        }

        header {
            background-color: #123c69;
            color: white;
            text-align: center;
            padding: 25px;
        }

        header img {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 10px;
        }

        header h1 {
            font-size: 28px;
        }

        nav {
            background-color: #0b2545;
            padding: 12px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ffd166;
        }

        main {
            max-width: 1100px;
            margin: auto;
            padding: 20px;
        }

        section {
            background-color: white;
            padding: 25px;
            margin-bottom: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #00000015;
        }

        h2 {
            color: #123c69;
            margin-bottom: 15px;
        }

        .helpdesk-image {
            width: 100%;
            max-height: 250px;
            object-fit: cover;
            border-radius: 8px;
            margin: 15px 0;
        }

        .helpdesk-info {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .helpdesk-info article {
            flex: 1;
            min-width: 220px;
            background-color: #eaf2f8;
            padding: 20px;
            border-radius: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #123c69;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f2f6fa;
        }

        a {
            color: #0756a3;
        }

        form {
            display: grid;
            gap: 15px;
        }

        label {
            font-weight: bold;
        }

        input, select, textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #bbb;
            border-radius: 5px;
            font-size: 15px;
        }

        button {
            background-color: #123c69;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            background-color: #0b2545;
        }

        footer {
            background-color: #0b2545;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @media (max-width: 600px) {
            header h1 {
                font-size: 22px;
            }

            nav a {
                display: inline-block;
                margin: 5px;
            }

            section {
                padding: 15px;
            }

            table {
                font-size: 13px;
            }

            th, td {
                padding: 8px;
            }
        }
    </style>
</head>

<body>

    <!-- University Header -->
    <header id="home">

        <img src="https://placehold.co/100x100?text=MRU"
             alt="Malla Reddy University logo placeholder">

        <h1>Malla Reddy University</h1>

        <p>Student Helpdesk & Circular Portal</p>

        <p>Information | Support | Updates</p>

    </header>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a>
        <a href="#helpdesk">Helpdesk</a>
        <a href="#circulars">Circulars</a>
        <a href="#resources">Resources</a>
        <a href="#enquiry">Enquiry</a>
    </nav>

    <!-- Main Content -->
    <main>

        <!-- Welcome Section -->
        <section>
            <h2>Welcome to Student Portal</h2>

            <p>
                The Student Helpdesk & Circular Portal provides
                students with important university information,
                academic notices, downloadable resources and
                enquiry facilities.
            </p>

            <img
                class="helpdesk-image"
                src="https://placehold.co/1000x300?text=Student+Helpdesk"
                alt="Student helpdesk banner placeholder">
        </section>

        <!-- Helpdesk Section -->
        <section id="helpdesk">

            <h2>Student Helpdesk</h2>

            <p>
                Students can contact the helpdesk for assistance
                regarding academic activities, examinations,
                admissions and general university information.
            </p>

            <div class="helpdesk-info">

                <article>
                    <h3>Academic Support</h3>
                    <p>
                        Get assistance with academic schedules,
                        courses and faculty-related enquiries.
                    </p>
                </article>

                <article>
                    <h3>Examination Support</h3>
                    <p>
                        Find information about examination
                        timetables, hall tickets and results.
                    </p>
                </article>

                <article>
                    <h3>Technical Support</h3>
                    <p>
                        Get help with student login,
                        portal access and technical issues.
                    </p>
                </article>

            </div>

            <p>
                <strong>Helpdesk Email:</strong>
                <a href="mailto:helpdesk@example.com">
                    helpdesk@example.com
                </a>
            </p>

            <p>
                <strong>Working Hours:</strong>
                Monday to Friday, 9:00 AM - 5:00 PM
            </p>

        </section>

        <!-- Circulars Section -->
        <section id="circulars">

            <h2>Latest University Circulars</h2>

            <p>
                Important notices and announcements for students.
            </p>

            <table>

                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Circular Title</th>
                        <th>Date</th>
                        <th>Category</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>1</td>
                        <td>Examination Schedule</td>
                        <td>20-11-2026</td>
                        <td>Examination</td>
                    </tr>

                    <tr>
                        <td>2</td>
                        <td>Student Registration Notice</td>
                        <td>18-11-2026</td>
                        <td>Academic</td>
                    </tr>

                    <tr>
                        <td>3</td>
                        <td>Holiday Announcement</td>
                        <td>15-11-2026</td>
                        <td>General</td>
                    </tr>

                    <tr>
                        <td>4</td>
                        <td>Workshop Registration</td>
                        <td>12-11-2026</td>
                        <td>Event</td>
                    </tr>

                </tbody>

            </table>

        </section>

        <!-- Resources Section -->
        <section id="resources">

            <h2>Downloadable Resources</h2>

            <p>
                Students can access the following sample resources.
            </p>

            <ul>
                <li>
                    <a href="resources/student-handbook.pdf" download>
                        Student Handbook
                    </a>
                </li>

                <li>
                    <a href="resources/exam-guidelines.pdf" download>
                        Examination Guidelines
                    </a>
                </li>

                <li>
                    <a href="resources/academic-calendar.pdf" download>
                        Academic Calendar
                    </a>
                </li>

                <li>
                    <a href="resources/registration-form.pdf" download>
                        Registration Form
                    </a>
                </li>
            </ul>

        </section>

        <!-- Student Enquiry Form -->
        <section id="enquiry">

            <h2>Student Enquiry Form</h2>

            <p>
                Fill in the form below to submit your enquiry.
            </p>

            <form action="#" method="post">

                <div>
                    <label for="name">Student Name:</label>
                    <input
                        type="text"
                        id="name"
                        name="student_name"
                        placeholder="Enter your name"
                        required>
                </div>

                <div>
                    <label for="roll">Roll Number:</label>
                    <input
                        type="text"
                        id="roll"
                        name="roll_number"
                        placeholder="Enter your roll number"
                        required>
                </div>

                <div>
                    <label for="email">Email Address:</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        required>
                </div>

                <div>
                    <label for="department">Department:</label>

                    <select id="department" name="department" required>

                        <option value="">Select Department</option>
                        <option value="cse">Computer Science</option>
                        <option value="ece">Electronics</option>
                        <option value="eee">Electrical</option>
                        <option value="civil">Civil</option>
                        <option value="mechanical">Mechanical</option>

                    </select>
                </div>

                <div>
                    <label for="category">Enquiry Category:</label>

                    <select id="category" name="category" required>

                        <option value="">Select Category</option>
                        <option value="academic">Academic</option>
                        <option value="examination">Examination</option>
                        <option value="technical">Technical Support</option>
                        <option value="general">General</option>

                    </select>
                </div>

                <div>
                    <label for="message">Your Enquiry:</label>

                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        placeholder="Write your enquiry here"
                        required></textarea>
                </div>

                <button type="submit">
                    Submit Enquiry
                </button>

            </form>

        </section>

    </main>

    <!-- Footer -->
    <footer>

        <p>
            &copy; 2026 Malla Reddy University
        </p>

        <p>
            Student Helpdesk & Circular Portal
        </p>

        <p>
            Designed using HTML5 and CSS
        </p>

    </footer>

</body>
</html>
