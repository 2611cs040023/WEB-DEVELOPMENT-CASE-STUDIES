
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Dashboard | Malla Reddy University</title>

    <!-- Bootstrap 5 CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <style>
        body {
            background-color: #f4f7fb;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background-color: #123c69;
        }

        .navbar-brand {
            font-weight: bold;
        }

        .dashboard-title {
            color: #123c69;
            font-weight: bold;
        }

        .summary-card {
            border: none;
            border-radius: 12px;
            transition: transform 0.3s;
        }

        .summary-card:hover {
            transform: translateY(-5px);
        }

        .summary-card h3 {
            font-size: 28px;
            font-weight: bold;
        }

        .profile-card {
            background-color: #123c69;
            color: white;
            border-radius: 12px;
        }

        .section-heading {
            color: #123c69;
            font-weight: bold;
        }

        .carousel img {
            height: 300px;
            object-fit: cover;
        }

        footer {
            background-color: #0b2545;
            color: white;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container">

            <a class="navbar-brand" href="#">
                MRU Student Dashboard
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarMenu"
                aria-controls="navbarMenu"
                aria-expanded="false"
                aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div
                class="collapse navbar-collapse"
                id="navbarMenu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link active" href="#dashboard">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#academics">
                            Academics
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#notices">
                            Notices
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#campus">
                            Campus
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- Main Dashboard -->
    <main class="container py-4" id="dashboard">

        <!-- Welcome -->
        <div class="mb-4">

            <h1 class="dashboard-title">
                Student Dashboard
            </h1>

            <p class="text-muted">
                Welcome to your academic dashboard.
                Manage your student information in one place.
            </p>

        </div>


        <!-- Alert -->
        <div
            class="alert alert-warning alert-dismissible fade show"
            role="alert">

            <strong>Important Notice!</strong>
            Check the latest examination schedule and
            complete your academic registration.

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
            </button>

        </div>


        <!-- Student Profile -->
        <section class="row mb-4">

            <div class="col-12">

                <div class="card profile-card shadow-sm">

                    <div class="card-body">

                        <h4 class="card-title">
                            Student Profile
                        </h4>

                        <p class="mb-1">
                            <strong>Name:</strong>
                            Student Name
                        </p>

                        <p class="mb-1">
                            <strong>Roll Number:</strong>
                            2611CS040023
                        </p>

                        <p class="mb-1">
                            <strong>Department:</strong>
                            Computer Science
                        </p>

                        <p class="mb-0">
                            <strong>Academic Year:</strong>
                            2026-2027
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- Summary Cards -->
        <section class="row g-3 mb-4">

            <div class="col-12 col-md-6 col-lg-3">

                <div class="card summary-card shadow-sm">

                    <div class="card-body text-center">

                        <h5 class="text-muted">
                            Attendance
                        </h5>

                        <h3 class="text-primary">
                            85%
                        </h3>

                        <p class="mb-0">
                            Overall Attendance
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-12 col-md-6 col-lg-3">

                <div class="card summary-card shadow-sm">

                    <div class="card-body text-center">

                        <h5 class="text-muted">
                            Academic Marks
                        </h5>

                        <h3 class="text-success">
                            82%
                        </h3>

                        <p class="mb-0">
                            Overall Performance
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-12 col-md-6 col-lg-3">

                <div class="card summary-card shadow-sm">

                    <div class="card-body text-center">

                        <h5 class="text-muted">
                            Assignments
                        </h5>

                        <h3 class="text-warning">
                            4
                        </h3>

                        <p class="mb-0">
                            Pending Assignments
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-12 col-md-6 col-lg-3">

                <div class="card summary-card shadow-sm">

                    <div class="card-body text-center">

                        <h5 class="text-muted">
                            CGPA
                        </h5>

                        <h3 class="text-danger">
                            8.5
                        </h3>

                        <p class="mb-0">
                            Current CGPA
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- Academic Performance Table -->
        <section class="card shadow-sm mb-4" id="academics">

            <div class="card-body">

                <h2 class="section-heading h4">
                    Academic Performance
                </h2>

                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead class="table-primary">

                            <tr>
                                <th>Subject</th>
                                <th>Minor-1</th>
                                <th>Minor-2</th>
                                <th>Assignment</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>Python Programming</td>
                                <td>85</td>
                                <td>88</td>
                                <td>90</td>
                                <td>
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                </td>
                            </tr>

                            <tr>
                                <td>Web Technology</td>
                                <td>78</td>
                                <td>82</td>
                                <td>85</td>
                                <td>
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                </td>
                            </tr>

                            <tr>
                                <td>Mathematics</td>
                                <td>75</td>
                                <td>80</td>
                                <td>70</td>
                                <td>
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </section>


        <!-- Buttons and Modal -->
        <section class="card shadow-sm mb-4">

            <div class="card-body">

                <h2 class="section-heading h4">
                    Student Information
                </h2>

                <p>
                    Click the button below to view
                    additional student information.
                </p>

                <button
                    type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#studentModal">

                    View Student Details

                </button>

                <button
                    type="button"
                    class="btn btn-outline-secondary"
                    onclick="window.print()">

                    Print Dashboard

                </button>

            </div>

        </section>


        <!-- Modal -->
        <div
            class="modal fade"
            id="studentModal"
            tabindex="-1"
            aria-labelledby="studentModalLabel"
            aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5
                            class="modal-title"
                            id="studentModalLabel">

                            Student Details

                        </h5>

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        <p>
                            <strong>Name:</strong>
                            Student Name
                        </p>

                        <p>
                            <strong>Roll Number:</strong>
                            2611CS040023
                        </p>

                        <p>
                            <strong>Department:</strong>
                            Computer Science
                        </p>

                        <p>
                            <strong>Email:</strong>
                            student@example.com
                        </p>

                    </div>

                    <div class="modal-footer">

                        <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                            Close

                        </button>

                    </div>

                </div>

            </div>

        </div>


        <!-- Campus Carousel -->
        <section class="card shadow-sm mb-4" id="campus">

            <div class="card-body">

                <h2 class="section-heading h4">
                    Campus Highlights
                </h2>

                <div
                    id="campusCarousel"
                    class="carousel slide"
                    data-bs-ride="carousel">

                    <!-- Indicators -->
                    <div class="carousel-indicators">

                        <button
                            type="button"
                            data-bs-target="#campusCarousel"
                            data-bs-slide-to="0"
                            class="active"
                            aria-current="true"
                            aria-label="Slide 1">
                        </button>

                        <button
                            type="button"
                            data-bs-target="#campusCarousel"
                            data-bs-slide-to="1"
                            aria-label="Slide 2">
                        </button>

                        <button
                            type="button"
                            data-bs-target="#campusCarousel"
                            data-bs-slide-to="2"
                            aria-label="Slide 3">
                        </button>

                    </div>


                    <!-- Carousel Images -->
                    <div class="carousel-inner">

                        <div class="carousel-item active">

                            <img
                                src="https://placehold.co/1200x400/123c69/ffffff?text=University+Campus"
                                class="d-block w-100"
                                alt="University campus">

                            <div class="carousel-caption d-none d-md-block">

                                <h5>University Campus</h5>

                                <p>
                                    Explore the university environment.
                                </p>

                            </div>

                        </div>


                        <div class="carousel-item">

                            <img
                                src="https://placehold.co/1200x400/345b7e/ffffff?text=Library"
                                class="d-block w-100"
                                alt="University library">

                            <div class="carousel-caption d-none d-md-block">

                                <h5>University Library</h5>

                                <p>
                                    A place for learning and research.
                                </p>

                            </div>

                        </div>


                        <div class="carousel-item">

                            <img
                                src="https://placehold.co/1200x400/5a7895/ffffff?text=Student+Activities"
                                class="d-block w-100"
                                alt="Student activities">

                            <div class="carousel-caption d-none d-md-block">

                                <h5>Student Activities</h5>

                                <p>
                                    Participate in campus events.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- Previous Button -->
                    <button
                        class="carousel-control-prev"
                        type="button"
                        data-bs-target="#campusCarousel"
                        data-bs-slide="prev">

                        <span
                            class="carousel-control-prev-icon"
                            aria-hidden="true">
                        </span>

                        <span class="visually-hidden">
                            Previous
                        </span>

                    </button>


                    <!-- Next Button -->
                    <button
                        class="carousel-control-next"
                        type="button"
                        data-bs-target="#campusCarousel"
                        data-bs-slide="next">

                        <span
                            class="carousel-control-next-icon"
                            aria-hidden="true">
                        </span>

                        <span class="visually-hidden">
                            Next
                        </span>

                    </button>

                </div>

            </div>

        </section>


        <!-- Notices -->
        <section class="card shadow-sm mb-4" id="notices">

            <div class="card-body">

                <h2 class="section-heading h4">
                    Important Notices
                </h2>

                <div class="alert alert-info">

                    <strong>Notice 1:</strong>
                    Examination schedule will be announced soon.

                </div>

                <div class="alert alert-success">

                    <strong>Notice 2:</strong>
                    Student registration is open.

                </div>

                <div class="alert alert-danger">

                    <strong>Notice 3:</strong>
                    Submit pending assignments before the deadline.

                </div>

            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer class="text-center py-4">

        <p class="mb-1">
            &copy; 2026 Malla Reddy University
        </p>

        <p class="mb-0">
            Student Dashboard | Bootstrap 5
        </p>

    </footer>


    <!-- Bootstrap 5 JavaScript Bundle -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
