
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Attendance & Exam Eligibility Checker</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>Student Attendance Portal</h1>
        <p>Attendance & Exam Eligibility Checker</p>
    </header>

    <main>

        <!-- Student Form -->
        <section class="form-section">

            <h2>Enter Student Details</h2>

            <form id="studentForm">

                <div class="form-group">
                    <label for="studentName">Student Name</label>
                    <input
                        type="text"
                        id="studentName"
                        placeholder="Enter student name"
                        required>
                </div>

                <div class="form-group">
                    <label for="rollNumber">Roll Number</label>
                    <input
                        type="text"
                        id="rollNumber"
                        placeholder="Enter roll number"
                        required>
                </div>

                <div class="form-group">
                    <label for="attendance">Attendance Percentage</label>
                    <input
                        type="number"
                        id="attendance"
                        min="0"
                        max="100"
                        step="0.01"
                        placeholder="Enter attendance percentage"
                        required>
                </div>

                <div class="form-group">
                    <label for="marks">Academic Performance (%)</label>
                    <input
                        type="number"
                        id="marks"
                        min="0"
                        max="100"
                        step="0.01"
                        placeholder="Enter academic marks percentage"
                        required>
                </div>

                <button type="submit">
                    Check Eligibility
                </button>

            </form>

        </section>

        <!-- Summary -->
        <section class="summary-section">

            <h2>Eligibility Summary</h2>

            <div class="summary-container">

                <div class="summary-card">
                    <h3>Total Students</h3>
                    <p id="totalStudents">0</p>
                </div>

                <div class="summary-card">
                    <h3>Eligible Students</h3>
                    <p id="eligibleStudents">0</p>
                </div>

                <div class="summary-card">
                    <h3>Not Eligible</h3>
                    <p id="notEligibleStudents">0</p>
                </div>

            </div>

        </section>

        <!-- Student Records -->
        <section class="table-section">

            <h2>Student Eligibility Records</h2>

            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>S.No</th>
                            <th>Name</th>
                            <th>Roll Number</th>
                            <th>Attendance</th>
                            <th>Academic Marks</th>
                            <th>Minor-1</th>
                            <th>Minor-2</th>
                            <th>Endterm</th>
                        </tr>
                    </thead>

                    <tbody id="studentTableBody">

                        <!-- JavaScript displays student records here -->

                    </tbody>

                </table>

            </div>

            <button
                type="button"
                class="clear-button"
                id="clearButton">
                Clear All Records
            </button>

        </section>

    </main>

    <footer>
        <p>&copy; 2026 Student Attendance Portal</p>
        <p>Designed using HTML, CSS and JavaScript</p>
    </footer>

    <script src="script.js"></script>

</body>
</html>
